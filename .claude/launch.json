{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "crossfx-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && .venv\\Scripts\\uvicorn.exe app.main:app --host 127.0.0.1 --port 8000"],
      "port": 8000
    },
    {
      "name": "crossfx-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
