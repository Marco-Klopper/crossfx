# --- App ---
APP_NAME=CrossFX
ENVIRONMENT=development
SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated origins allowed to call the API from a browser (Track 4's frontend).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://crossfx:crossfx@localhost:5432/crossfx
# DATABASE_URL=sqlite:///./crossfx.db   # local dev alternative — models use portable
                                        # sqlalchemy.Uuid, so this genuinely works now.

# --- Private key encryption ---
# The encryption key for Fernet-encrypted private keys.
# Consider a secrets manager (AWS KMS/Secrets Manager, Vault) for production-grade handling.
# Generate a real key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRIVATE_KEY_ENCRYPTION_KEY=change-me-fernet-key

# --- XRPL Testnet ---
XRPL_TESTNET_JSON_RPC=https://s.altnet.rippletest.net:51234
XRPL_TESTNET_WSS=wss://s.altnet.rippletest.net:51233
UCTUSD_ISSUER_ADDRESS=rELez4x4Zqv3KYqboYVfrYPF8521Ycbxa5
UCTUSD_CURRENCY_CODE=5543545553440000000000000000000000000000
# Liquidity is sent from the course distributor: rsWPX7FKwnfk6enosumAzEuTs5Y12Steq4

# The two pooled corridor wallets (spec 9.1) are NOT configured here. Their
# seeds are Fernet-encrypted and stored in the platform_wallets table, so that
# the encryption key (above) is the only secret outside the database. Create
# them once, after migrating:
#   python -m scripts.init_platform_wallets
#
# --- Internal ledger ---
SUPPORTED_CURRENCIES=UCTUSD,USD,ZAR

# --- FX / fees ---
# mock  = deterministic, slowly-moving rate, no network (use this for the demo
#         and the load tests). api = a public endpoint, cached. table = the
#         latest fx_rates row, seeded with: python -m scripts.seed_fx_rates
EXCHANGE_RATE_SOURCE=mock   # mock | api | table
FIXED_REMITTANCE_FEE_ZAR=25
PERCENT_FEE_BPS=150          # 1.50%
FX_MARGIN_BPS=100            # 1.00%
CASHOUT_FEE_BPS=100

# mock mode: the rate to oscillate around, and the drift either side of it.
# Set the volatility to 0 to pin the rate flat for a scripted demo.
FX_MOCK_BASE_RATE=18.50
FX_MOCK_VOLATILITY_BPS=150

# api mode. Keyless, USD-base: {"rates": {"ZAR": 18.42, ...}}. The response
# path is config too, so swapping provider is a .env change, not a code one.
FX_API_URL=https://open.er-api.com/v6/latest/USD
FX_API_RATE_PATH=rates.ZAR
FX_API_TIMEOUT_SECONDS=5.0
# Quoting must stay pure compute, so a fetched rate is reused this long.
FX_RATE_CACHE_SECONDS=300

# How long a quote is honoured before the sender must request a new one.
QUOTE_TTL_MINUTES=15

# --- Remittance limits (ZAR) ---
UNVERIFIED_DAILY_LIMIT=0
UNVERIFIED_MONTHLY_LIMIT=0
VERIFIED_DAILY_LIMIT=3000
VERIFIED_MONTHLY_LIMIT=25000

# --- Message queue ---
QUEUE_BACKEND=redis          # redis | rabbitmq | kafka
REDIS_URL=redis://localhost:6379/0
SETTLEMENT_STREAM_NAME=crossfx-settlement-queue
SETTLEMENT_CONSUMER_GROUP=crossfx-settlement-workers
SETTLEMENT_BLOCK_MS=5000
